{
  "name": "cc-reforged",
  "version": "0.2.0",
  "bin": {
    "ccr": "cli.js"
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "LICENSE.md",
    "cli.js",
    "bun-bundle-loader.mjs",
    "dist/**/*.js",
    "dist/**/*.txt",
    "vendor/claude-for-chrome-mcp-stub.mjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "author": "CCR maintainers",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "CCR is a terminal coding agent recovery build with a built-in pluggable LLM runtime.",
  "keywords": [
    "ccr",
    "coding-agent",
    "llm",
    "codex-oauth",
    "terminal"
  ],
  "homepage": "https://github.com/mhdfy1988/cc-reforged",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhdfy1988/cc-reforged.git"
  },
  "bugs": {
    "url": "https://github.com/mhdfy1988/cc-reforged/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.AUTHORIZED) { console.error('ERROR: Direct publishing is not allowed.\\nPlease see the release workflow documentation to publish this package.'); process.exit(1); }\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ./scripts/copy-text-assets.mjs",
    "audit:runtime-targets": "node ./scripts/audit-runtime-targets.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:config": "tsc -p tsconfig.typecheck.json --showConfig",
    "build:config": "tsc -p tsconfig.build.json --showConfig",
    "smoke:anthropic-provider": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-anthropic-provider.mjs",
    "smoke:codex-oauth-session": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-codex-oauth-session.mjs",
    "smoke:codex-oauth-provider": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-codex-oauth-provider.mjs",
    "smoke:llm-claude-adapter": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-llm-claude-adapter.mjs",
    "smoke:llm-config": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-llm-config.mjs",
    "smoke:llm-runtime": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-llm-runtime.mjs",
    "smoke:llm-runtime-status": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-llm-runtime-status.mjs",
    "smoke:runtime": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-runtime.mjs",
    "smoke:permissions": "node --no-warnings --experimental-loader ./bun-bundle-loader.mjs ./scripts/smoke-permissions.mjs",
    "smoke:deps": "node ./scripts/smoke-deps.mjs",
    "ci:smoke": "node ./scripts/ci-smoke.mjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@anthropic-ai/sdk": "^0.57.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@growthbook/growthbook": "^1.6.5",
    "@mariozechner/pi-ai": "^0.58.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/plist": "^3.0.5",
    "axios": "^1.9.0",
    "bidi-js": "^1.0.3",
    "cacache": "^20.0.4",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "cli-boxes": "^4.0.1",
    "diff": "^7.0.0",
    "env-paths": "^4.0.0",
    "execa": "^9.5.2",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.3.0",
    "https-proxy-agent": "^9.0.0",
    "ignore": "^7.0.4",
    "indent-string": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.1.0",
    "marked": "^18.0.0",
    "p-map": "^7.0.3",
    "picomatch": "^4.0.4",
    "plist": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "semver": "^7.7.1",
    "shell-quote": "^1.8.3",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^4.4.0",
    "tree-kill": "^1.2.2",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "ws": "^8.18.2",
    "xss": "^1.0.15",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/diff": "^7.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/semver": "^7.7.0",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.34.2",
    "@img/sharp-darwin-x64": "^0.34.2",
    "@img/sharp-linux-arm": "^0.34.2",
    "@img/sharp-linux-arm64": "^0.34.2",
    "@img/sharp-linux-x64": "^0.34.2",
    "@img/sharp-linuxmusl-arm64": "^0.34.2",
    "@img/sharp-linuxmusl-x64": "^0.34.2",
    "@img/sharp-win32-arm64": "^0.34.2",
    "@img/sharp-win32-x64": "^0.34.2"
  }
}
