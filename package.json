  "build": {
    "appId": "dev.ccr.desktop",
    "productName": "CCR",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "out/**/*",
      "apps/desktop/assets/generated/**/*",
      "dist/**/*",
      "vendor/**/*",
      "cli.js",
      "bun-bundle-loader.mjs",
      "package.json",
      "LICENSE.md",
      "README.md",
      "README.en.md",
      "README.zh-CN.md"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/patch-desktop-exe-icon.mjs",
    "win": {
      "icon": "apps/desktop/assets/generated/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CCR-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "apps/desktop/assets/generated/icon.ico",
      "uninstallerIcon": "apps/desktop/assets/generated/icon.ico",
      "shortcutName": "CCR",
      "uninstallDisplayName": "CCR"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mhdfy1988",
        "repo": "cc-reforged"
      }
    ]
  },
